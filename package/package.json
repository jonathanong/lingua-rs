{
  "name": "lingua-rs",
  "version": "0.2.4",
  "description": "Language detection for Node.js — wraps the Rust lingua crate, detects 75 languages",
  "main": "index.js",
  "types": "index.d.ts",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@11.0.3",
  "repository": {
    "type": "git",
    "url": "https://github.com/jonathanong/lingua-rs.git"
  },
  "keywords": [
    "language",
    "detection",
    "nlp",
    "lingua",
    "napi"
  ],
  "files": [
    "index.js",
    "index.d.ts",
    "postinstall.js",
    "request.js",
    "transfer.js",
    "retry.js",
    "checksums.js",
    "install-env.js",
    "checksums.json"
  ],
  "napi": {
    "binaryName": "lingua_rs",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "postinstall": "node postinstall.js"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.12",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
